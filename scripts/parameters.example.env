# StickersBanners credential values — TEMPLATE.
#
# Copy this file to `scripts/parameters.dev.env` (git-ignored) and fill in the
# real values, then run:  scripts/seed-parameters.sh dev
#
# Each line maps to an SSM SecureString parameter at /sb/<env>/<group>/<key>.
# Do NOT commit the filled-in copy. The repo is public.

# OrderDesk
ORDERDESK_API_KEY=
ORDERDESK_STORE_ID=

# Zendesk
ZENDESK_SUBDOMAIN=stickersbanners
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Customer proof approval links.
#
# Seeding BOTH of these is the switchover from Linh's proof portal to ours: the
# proof-ready email starts carrying a signed link to our own approval page, so
# approvals reach THIS pipeline. Clearing either one falls straight back to
# proof.stickersbanners.com — no deploy either way.
#
# APPROVAL_LINK_SECRET: any long random string, e.g. `openssl rand -base64 48`.
#   Rotating it invalidates every link already in a customer's inbox, so only
#   rotate when you mean to.
# APPROVAL_PORTAL_BASE: the deployed proof page, i.e. the sb-dev-webapp stack's
#   DashboardUrl output + /proof.html
APPROVAL_LINK_SECRET=
APPROVAL_PORTAL_BASE=

# Production-facility FTP
FTP_HOST=64.57.252.252
FTP_USER=branch
FTP_PASSWORD=

# Discord
DISCORD_WEBHOOK_URL=

# Shopify app "Manage My Order Button" (Dev Dashboard -> Settings -> Credentials)
SHOPIFY_SHOP_DOMAIN=stickersbanners.myshopify.com
SHOPIFY_CLIENT_ID=b947d4872d45ff98da1740ae00fd529d
SHOPIFY_CLIENT_SECRET=

# Google Chat space webhook for paid shipping changes
GCHAT_WEBHOOK_URL=

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google service account: path to the service_account.json file on disk
# (its full contents are stored as one SecureString parameter).
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=
