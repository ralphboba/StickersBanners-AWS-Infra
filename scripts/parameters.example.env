# StickersBanners credential values — TEMPLATE.
#
# Copy this file to `scripts/parameters.dev.env` (git-ignored) and fill in the
# real values, then run:  scripts/seed-parameters.sh dev
#
# Each line maps to an SSM SecureString parameter at /sb/<env>/<group>/<key>.
# Do NOT commit the filled-in copy. The repo is public.

# OrderDesk
ORDERDESK_API_KEY=
ORDERDESK_STORE_ID=

# Zendesk
ZENDESK_SUBDOMAIN=stickersbanners
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Production-facility FTP
FTP_HOST=64.57.252.252
FTP_USER=branch
FTP_PASSWORD=

# Discord
DISCORD_WEBHOOK_URL=

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google service account: path to the service_account.json file on disk
# (its full contents are stored as one SecureString parameter).
GOOGLE_SERVICE_ACCOUNT_JSON_FILE=
