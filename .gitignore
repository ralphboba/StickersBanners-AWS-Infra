*.js
!jest.config.js
# Vendored browser libraries are source, not build output: the proof page
# serves them from our own bucket so a public CDN outage cannot blank a
# customer's proof, and so the viewer can be rendered and checked locally.
!web/vendor/**/*.js
*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# Local credential value files for seed-parameters.sh — NEVER commit these
scripts/parameters.*.env
!scripts/parameters.example.env

# Google service account key files
*service_account*.json
*service-account*.json

# Python build artifacts
__pycache__/
*.pyc

# Machine-local Claude Code settings. The committed .claude/settings.json holds
# the permission rules (a project decision); this one holds per-machine setup
# and must never be committed — the repo is public.
.claude/settings.local.json
